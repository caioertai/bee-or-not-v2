- if type == "notice"
  - css_class = "bg-green-100 border-green-400 text-green-700"
- elsif type == "alert"
  - css_class = "bg-red-100 border-red-400 text-red-700"
- elsif type == "warning"
  - css_class = "bg-yellow-100 border-yellow-400 text-yellow-700"
- else
  - css_class = "bg-blue-100 border-blue-400 text-blue-700"

.fixed.top-4.right-4.z-50.max-w-sm.w-full
  .border.rounded-lg.p-4.shadow-lg class=css_class data-turbo-temporary="true"
    .flex.justify-between.items-start
      .text-sm.font-medium = message
      button.text-gray-400.hover:text-gray-600 type="button" onClick="this.parentElement.parentElement.remove()"
        span.sr-only Close
        svg.h-4.w-4 fill="currentColor" viewBox="0 0 20 20"
