.min-h-screen.bg-gradient-to-br.from-blue-50.to-indigo-100.dark:from-gray-900.dark:to-gray-800.flex.items-center.justify-center.px-4.transition-colors.duration-300
  .max-w-lg.mx-auto.text-center
    .bg-white.dark:bg-gray-800.rounded-lg.shadow-lg.p-8.transition-colors.duration-300
      .text-6xl.mb-6 🎯
      h1.text-3xl.font-bold.text-gray-900.dark:text-white.mb-6 Game Complete!
      
      .mb-8.space-y-4
        .bg-blue-50.dark:bg-blue-900/30.rounded-lg.p-6.transition-colors.duration-300
          .text-3xl.font-bold.text-blue-600.dark:text-blue-400.mb-2 = @game.score
          .text-lg.text-blue-800.dark:text-blue-300 out of #{@game.total_rounds} correct
          .text-2xl.font-bold.text-blue-600.dark:text-blue-400.mt-2 = number_to_percentage(@game.accuracy_ratio * 100, precision: 1)
          .text-sm.text-blue-600.dark:text-blue-300 accuracy
        
        - if @game.accuracy_ratio >= 0.8
          .text-green-600.dark:text-green-400.font-semibold 🏆 Excellent! You're great at spotting fake news!
        - elsif @game.accuracy_ratio >= 0.6
          .text-yellow-600.dark:text-yellow-400.font-semibold 👍 Good job! Keep practicing to improve your skills.
        - else
          .text-red-600.dark:text-red-400.font-semibold 🤔 Keep practicing! Fake news detection takes time to master.
      
      .space-y-4
        = link_to "Play Again", new_game_path, 
                  class: "block w-full bg-green-600 hover:bg-green-700 dark:bg-green-500 dark:hover:bg-green-600 text-white font-bold py-3 px-6 rounded-lg transition-colors duration-200 text-lg"
        
        = link_to "← Back to Home", root_path, 
                  class: "block w-full border-2 border-gray-300 dark:border-gray-600 hover:border-gray-400 dark:hover:border-gray-500 text-gray-700 dark:text-gray-300 font-bold py-3 px-6 rounded-lg transition-colors duration-200"
      
