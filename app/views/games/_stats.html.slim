.bg-white.rounded-lg.shadow-md.p-6.mb-6
  .flex.justify-between.items-center.mb-4
    h2.text-2xl.font-bold.text-gray-900 🎯 Game Stats
    = link_to "End Game", game_path(@game.id), class: "text-sm text-blue-600 hover:text-blue-800"
  
  .grid.grid-cols-1.md:grid-cols-3.gap-4.text-center
    .bg-blue-50.rounded-lg.p-4
      .text-2xl.font-bold.text-blue-600 = game.score
      .text-sm.text-gray-600 Correct
    
    .bg-purple-50.rounded-lg.p-4
      .text-2xl.font-bold.text-purple-600 = game.total_rounds
      .text-sm.text-gray-600 Total Rounds
    
    .bg-green-50.rounded-lg.p-4
      .text-2xl.font-bold.text-green-600 = number_to_percentage(game.accuracy_ratio * 100, precision: 1)
      .text-sm.text-gray-600 Accuracy