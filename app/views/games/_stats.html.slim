.bg-white.dark:bg-gray-800.rounded-lg.shadow-md.p-6.mb-6.transition-colors.duration-300
  .flex.justify-between.items-center.mb-4
    h2.text-2xl.font-bold.text-gray-900.dark:text-white 🎯 Game Stats
    = link_to "End Game", game_path(@game.id), class: "text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300"
  
  .grid.grid-cols-1.md:grid-cols-3.gap-4.text-center
    .bg-blue-50.dark:bg-blue-900/30.rounded-lg.p-4.transition-colors.duration-300
      .text-2xl.font-bold.text-blue-600.dark:text-blue-400 = game.score
      .text-sm.text-gray-600.dark:text-gray-300 Correct
    
    .bg-purple-50.dark:bg-purple-900/30.rounded-lg.p-4.transition-colors.duration-300
      .text-2xl.font-bold.text-purple-600.dark:text-purple-400 = game.total_rounds
      .text-sm.text-gray-600.dark:text-gray-300 Total Rounds
    
    .bg-green-50.dark:bg-green-900/30.rounded-lg.p-4.transition-colors.duration-300
      .text-2xl.font-bold.text-green-600.dark:text-green-400 = number_to_percentage(game.accuracy_ratio * 100, precision: 1)
      .text-sm.text-gray-600.dark:text-gray-300 Accuracy