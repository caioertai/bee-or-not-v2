.min-h-screen.bg-gradient-to-br.from-blue-50.to-indigo-100.flex.items-center.justify-center.px-4
  .max-w-md.mx-auto
    .bg-white.rounded-lg.shadow-lg.p-8
      .text-center.mb-6
        .text-6xl.mb-4 🎮
        h1.text-2xl.font-bold.text-gray-900 Join Game
        .text-sm.text-gray-600.mt-2 You're about to join a multiplayer game!
      
      = form_with url: game_players_path(@game), method: :post, local: false, 
                  class: "space-y-4", data: { turbo_stream: true } do |form|
        .space-y-4
          .text-center
            label.block.text-sm.font-medium.text-gray-700.mb-2 Choose your player name:
            = form.text_field :player_name, value: @player_name, 
                              class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-center",
                              placeholder: "Enter your name",
                              maxlength: 50
          
          .text-center
            = form.submit "Join Game", 
                          class: "w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-6 rounded-lg transition-colors duration-200"
      
      .text-center.mt-6
        = link_to "← Back to Home", root_path, 
                  class: "text-gray-600 hover:text-gray-800 text-sm"
      
      .mt-8.text-center
        .text-xs.text-gray-500 
          | Game ID: #{@game.id}
          br
          | Players: #{@game.players.count}